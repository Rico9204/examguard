# 이 파일을 복사해 .env.local로 이름을 바꾸고 값을 채우세요. (.env.local은 키가 들어 있으니 제출·공유 금지)
# 시스템 환경 변수가 있으면 그쪽이 우선합니다. run.bat으로 실행하면 이 폴더에서 읽습니다.

# ollama(기본, 로컬) 또는 openai(클라우드 — 이미지가 OpenAI 서버로 전송됨)
EXAMGUARD_PROVIDER=openai
OPENAI_API_KEY=
# 생략하면 openai → gpt-5-mini, ollama → gemma3:4b
# EXAMGUARD_VISION_MODEL=gpt-5-mini   (AI 안경급 경량 모델)
# EXAMGUARD_VISION_MODEL=gpt-5.4      (Muse Spark·Gemini 3.1 Pro급 최상위 모델 대용)
